@echo off
cd /d "%~dp0.."
if not exist "experiments_full_context\global\latent_transformer\best.pt" (
  echo Missing full-context checkpoints. Finish global and source training first.
  exit /b 1
)
start "Full Context Transformer Evaluation - RTX 4080" cmd /k "set CUDA_VISIBLE_DEVICES=0&& .venv\Scripts\python.exe evaluate_full_context.py --checkpoint experiments_full_context/global/latent_transformer/best.pt --calibration-region global --test-region global --calibration-label global --device cuda --stations data/tg/daily_temperature_2010_2021.parquet --era5 data/era5_daily_t2m_2010_2021.nc --output experiments_full_context/results/latent_transformer_global_sparse.csv && .venv\Scripts\python.exe evaluate_full_context.py --checkpoint experiments_full_context/source/latent_transformer/best.pt --calibration-region source --test-region target --calibration-label transferred --device cuda --stations data/tg/daily_temperature_2010_2021.parquet --era5 data/era5_daily_t2m_2010_2021.nc --output experiments_full_context/results/latent_transformer_transfer_sparse.csv && .venv\Scripts\python.exe evaluate_full_context.py --checkpoint experiments_full_context/source/latent_transformer/best.pt --calibration-region target --test-region target --calibration-label oracle_target --device cuda --stations data/tg/daily_temperature_2010_2021.parquet --era5 data/era5_daily_t2m_2010_2021.nc --output experiments_full_context/results/latent_transformer_oracle_sparse.csv"
start "Full Context ConvCNP Evaluation - RTX 5060 Ti" cmd /k "set CUDA_VISIBLE_DEVICES=1&& .venv\Scripts\python.exe evaluate_full_context.py --checkpoint experiments_full_context/global/convcnp/best.pt --calibration-region global --test-region global --calibration-label global --device cuda --stations data/tg/daily_temperature_2010_2021.parquet --era5 data/era5_daily_t2m_2010_2021.nc --output experiments_full_context/results/convcnp_global_sparse.csv && .venv\Scripts\python.exe evaluate_full_context.py --checkpoint experiments_full_context/source/convcnp/best.pt --calibration-region source --test-region target --calibration-label transferred --device cuda --stations data/tg/daily_temperature_2010_2021.parquet --era5 data/era5_daily_t2m_2010_2021.nc --output experiments_full_context/results/convcnp_transfer_sparse.csv && .venv\Scripts\python.exe evaluate_full_context.py --checkpoint experiments_full_context/source/convcnp/best.pt --calibration-region target --test-region target --calibration-label oracle_target --device cuda --stations data/tg/daily_temperature_2010_2021.parquet --era5 data/era5_daily_t2m_2010_2021.nc --output experiments_full_context/results/convcnp_oracle_sparse.csv"
echo Started all-station neural evaluations.
